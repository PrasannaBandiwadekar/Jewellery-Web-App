@model NageshaJewellers.ViewModels.ForgotPasswordViewModel

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-4">

            <div class="card shadow p-4">

                <h3 class="text-center mb-4">
                    Forgot Password
                </h3>

                <form method="post">

                    <div class="mb-3">

                        <label>Email</label>

                        <input asp-for="Email"
                               class="form-control" />

                    </div>

                    <button class="btn btn-warning w-100">

                        Send OTP

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>