@model NageshaJewellers.ViewModels.ResetPasswordViewModel

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-4">

            <div class="card shadow p-4">

                <h3 class="text-center mb-4">
                    Reset Password
                </h3>

                <form method="post">

                    <input asp-for="Email" hidden />

                    <div class="mb-3">

                        <label>OTP</label>

                        <input asp-for="OTP"
                               class="form-control" />

                    </div>

                    <div class="mb-3">

                        <label>New Password</label>

                        <input asp-for="NewPassword"
                               class="form-control" />

                    </div>

                    <button class="btn btn-success w-100">

                        Reset Password

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>