<div class="container mt-5">

    <div class="row">

        <div class="col-md-6">

            <div class="card p-4 shadow">

                <h3>Total Products</h3>

                <h1>@ViewBag.TotalProducts</h1>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card p-4 shadow">

                <h3>Total Users</h3>

                <h1>@ViewBag.TotalUsers</h1>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card p-4 shadow">

                <h3>Total Categories</h3>

                <h1>@ViewBag.TotalCategories</h1>

            </div>

        </div>

        <div class="col-md-6">

            <div class="card p-4 shadow">

                <h3>Total Enquiries</h3>

                <h1>@ViewBag.TotalEnquirries</h1>

            </div>

        </div>

    </div>

</div>