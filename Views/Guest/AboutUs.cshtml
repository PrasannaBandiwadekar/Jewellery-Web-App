@{
    ViewData["Title"] = "About Us";
}

<style>

    .about-banner {
        background: linear-gradient(rgba(0,0,0,0.6),rgba(0,0,0,0.6)),url('/images/about-banner.jpg');
        background-size: cover;
        background-position: center;
        height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
    }

    .section-title {
        font-weight: 700;
        margin-bottom: 25px;
        color: #d4af37;
    }

    .icon-box {
        padding: 25px;
        transition: 0.3s;
    }

        .icon-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.2);
        }

</style>


<!-- ABOUT BANNER -->

<section class="about-banner">

    <div>

        <h1 class="display-4 fw-bold">About Nagesha Jewellers</h1>

        <p>Tradition • Trust • Timeless Beauty</p>

    </div>

</section>


<br>


<!-- ABOUT CONTENT -->

<div class="container">

    <div class="row align-items-center">

        <div class="col-md-6">

            <img src="/images/jewellery-shop.png" class="img-fluid rounded shadow">

        </div>

        <div class="col-md-6">

            <h2 class="section-title">Our Story</h2>

            <p>

                Nagesha Jewellers is a trusted jewellery store known for its premium gold and silver collections.
                For years we have been providing elegant and traditional jewellery designs that celebrate culture and beauty.

            </p>

            <p>

                Our jewellery is crafted with precision and attention to detail.
                We believe jewellery is not just an ornament but a symbol of love, tradition, and memories.

            </p>

            <p>

                We offer a wide range of gold, silver, and diamond jewellery designed to suit every occasion including weddings, festivals, and special celebrations.

            </p>

        </div>

    </div>

</div>


<br>
<br>


<!-- WHY CHOOSE US -->

<section class="bg-light p-5">

    <div class="container text-center">

        <h2 class="section-title">Why Choose Nagesha Jewellers?</h2>

        <div class="row">

            <div class="col-md-4 mb-4">

                <div class="card icon-box">

                    <h4>✔ Certified Jewellery</h4>

                    <p>All our gold jewellery is BIS hallmarked ensuring purity and trust.</p>

                </div>

            </div>


            <div class="col-md-4 mb-4">

                <div class="card icon-box">

                    <h4>✔ Unique Designs</h4>

                    <p>We provide traditional and modern jewellery collections.</p>

                </div>

            </div>


            <div class="col-md-4 mb-4">

                <div class="card icon-box">

                    <h4>✔ Customer Satisfaction</h4>

                    <p>Our priority is delivering the best service and quality to customers.</p>

                </div>

            </div>

        </div>

    </div>

</section>


<br>


<!-- OUR MISSION -->

<div class="container text-center">

    <h2 class="section-title">Our Mission</h2>

    <p class="lead">

        Our mission is to provide beautiful, high-quality jewellery that brings joy and elegance to every customer.
        We strive to maintain trust, craftsmanship, and excellence in every piece we create.

    </p>

</div>


<br>
<br>


<!-- CALL TO ACTION -->

<section class="bg-warning text-center p-5">

    <h2>Explore Our Beautiful Jewellery Collection</h2>

    <p>Visit our designs page to see our exclusive jewellery collections.</p>

    <a href="/Guest/Designs" class="btn btn-dark btn-lg">View Designs</a>

</section>