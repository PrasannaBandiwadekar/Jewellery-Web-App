@using X.PagedList
@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<NageshaJewellers.Models.Product>
@{
    ViewData["Title"] = "Collections";
}

<style>

    body {
        background-color: #f8f9fa;
    }

    /* HERO SECTION */

    .collection-banner {
        background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('/images/designs-banner.jpg');
        background-size: cover;
        background-position: center;
        height: 400px;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: white;
    }

        .collection-banner h1 {
            font-size: 60px;
            font-weight: bold;
        }

        .collection-banner p {
            font-size: 22px;
        }

    /* SECTION */

    .section-title {
        color: #d4af37;
        font-weight: bold;
    }

    /* SEARCH */

    .search-box {
        border-radius: 30px;
        padding: 12px 20px;
    }

    /* FILTER BUTTON */

    .filter-btn {
        margin: 5px;
        border-radius: 30px;
        padding: 8px 22px;
    }

    /* PRODUCT CARD */

    .product-card {
        border-radius: 15px;
        overflow: hidden;
        transition: 0.3s;
        cursor: pointer;
        background: white;
    }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

    /* IMAGE */

    .product-img {
        height: 250px;
        object-fit: cover;
        padding: 10px;
        background: #fff;
    }

    /* PRICE */

    .price {
        color: #d4af37;
        font-size: 22px;
        font-weight: bold;
    }

    /* CATEGORY BADGE */

    .category-badge {
        background-color: #000;
        color: white;
        border-radius: 20px;
        padding: 5px 15px;
        font-size: 13px;
    }

    /* MODAL IMAGE */

    .modal-img {
        max-height: 350px;
        object-fit: contain;
    }

    /* EMPTY */

    .empty-box {
        padding: 60px;
    }

</style>

<!-- HERO BANNER -->

<section class="collection-banner">

    <div>

        <h1>
            Our Jewellery Collections
        </h1>

        <p>
            Explore Premium Gold, Silver & Diamond Designs
        </p>

    </div>

</section>

<br />

<div class="container">

    <!-- TITLE -->

    <div class="text-center mb-4">

        <h2 class="section-title">

            Exclusive Collections

        </h2>

        <p class="text-muted">

            Total Products :
            <strong>@Model.Count()</strong>

        </p>

    </div>

    <!-- SEARCH BAR -->

    <div class="row justify-content-center mb-4">

        <div class="col-md-6">

            <input type="text"
                   id="searchInput"
                   class="form-control shadow-sm search-box"
                   placeholder="Search Jewellery..." />

        </div>

    </div>

    <!-- FILTER BUTTONS -->

    <div class="text-center mb-5">

        <button class="btn btn-outline-warning filter-btn"
                onclick="filterProducts('all')">

            All

        </button>

        <button class="btn btn-outline-warning filter-btn"
                onclick="filterProducts('gold')">

            Gold

        </button>

        <button class="btn btn-outline-secondary filter-btn"
                onclick="filterProducts('silver')">

            Silver

        </button>

        <button class="btn btn-outline-dark filter-btn"
                onclick="filterProducts('diamond')">

            Diamond

        </button>

    </div>

    <!-- PRODUCT GRID -->

    <div class="row" id="productGrid">

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4 product-item @item.Category.ToLower()">

                    <div class="card border-0 shadow-sm product-card h-100"
                         onclick="openModal(
                                    '@item.Name',
                                    '@item.Price',
                                    '@item.ImagePath',
                                    '@item.Description',
                                    '@item.Category',
                                    '@item.Id'
                                 )">

                        <!-- IMAGE -->

                        <img src="@Url.Content(item.ImagePath)"
                             class="card-img-top product-img"
                             alt="@item.Name"
                             onerror="this.src='/images/no-image.png'" />

                        <!-- BODY -->

                        <div class="card-body text-center">

                            <span class="category-badge">

                                @item.Category

                            </span>

                            <h5 class="fw-bold mt-3">

                                @item.Name

                            </h5>

                            <p class="price"">

                                ₹@item.Price

                            </p>

                            <button class="btn btn-warning w-100">

                                View Details

                            </button>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12 text-center empty-box">

                <img src="/images/no-products.png"
                     width="250"
                     class="mb-3" />

                <h3>

                    No Jewellery Collections Available

                </h3>

                <p class="text-muted">

                    Admin has not added products yet.

                </p>

            </div>
        }

    </div>

</div>

<!-- PRODUCT MODAL -->

<div class="modal fade"
     id="jewelModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content border-0 shadow">

            <!-- HEADER -->

            <div class="modal-header border-0">

                <h4 class="fw-bold">

                    Product Details

                </h4>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <!-- BODY -->

            <div class="modal-body">

                <div class="row align-items-center">

                    <!-- IMAGE -->

                    <div class="col-md-6 text-center">

                        <img id="mImg"
                             src=""
                             class="img-fluid rounded modal-img shadow-sm" />

                    </div>

                    <!-- DETAILS -->

                    <div class="col-md-6">

                        <h2 id="mTitle"
                            class="fw-bold">
                        </h2>

                        <h3 id="mPrice"
                            class="price my-3">
                        </h3>

                        <span id="mCategory"
                              class="badge bg-dark mb-3">
                        </span>

                        <p id="mDesc"
                           class="text-muted mt-3">
                        </p>

                        <!-- WHATSAPP -->

                        <a id="whatsappBtn"
                           href="#"
                           target="_blank"
                           class="btn btn-success w-100 mt-3">

                            Enquire via WhatsApp

                        </a>

                        <!-- EDIT -->

                        <a id="editProductBtn"
                           class="btn btn-primary w-100 mt-2">

                            Edit Product

                        </a>

                        <!-- DELETE -->

                        <a id="deleteProductBtn"
                           class="btn btn-danger w-100 mt-2"
                           onclick="return confirm('Are you sure you want to delete this product?')">

                            Delete Product

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
<div class="d-flex justify-content-center mt-4">

    @Html.PagedListPager(
    Model,
    page => Url.Action("Designs", new { page }),
        new PagedListRenderOptions
        {
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always
        })

</div>              

<script>

    // FILTER PRODUCTS

    function filterProducts(category) {

        let products =
            document.querySelectorAll(".product-item");

        products.forEach(product => {

            if (category === "all" ||
                product.classList.contains(category)) {

                product.style.display = "block";

            }
            else {

                product.style.display = "none";

            }

        });
    }

    // SEARCH PRODUCTS

    document.getElementById("searchInput")
        .addEventListener("keyup", function () {

            let value =
                this.value.toLowerCase();

            let products =
                document.querySelectorAll(".product-item");

            products.forEach(product => {

                let text =
                    product.innerText.toLowerCase();

                if (text.includes(value)) {

                    product.style.display = "block";

                }
                else {

                    product.style.display = "none";

                }

            });

        });

    // OPEN MODAL

    function openModal(name,
                       price,
                       img,
                       desc,
                       category,
                       id) {

        // TITLE

        document.getElementById("mTitle")
            .innerText = name;

        // PRICE

        document.getElementById("mPrice")
            .innerText = "₹" + price;

        // IMAGE

        document.getElementById("mImg")
            .src = img;

        // DESCRIPTION

        document.getElementById("mDesc")
            .innerText = desc;

        // CATEGORY

        document.getElementById("mCategory")
            .innerText = category;

        // WHATSAPP LINK

        let whatsappMessage =
            `Hello, I am interested in ${name} costing ₹${price}`;

        let whatsappLink =
            `https://wa.me/918421058477?text=${encodeURIComponent(whatsappMessage)}`;

        document.getElementById("whatsappBtn")
            .href = whatsappLink;

        // EDIT BUTTON

        document.getElementById("editProductBtn")
            .href = `/Admin/EditProduct/${id}`;

        // DELETE BUTTON

        document.getElementById("deleteProductBtn")
            .href = `/Admin/DeleteProduct/${id}`;

        // SHOW MODAL

        new bootstrap.Modal(
            document.getElementById('jewelModal')
        ).show();
    }

</script>