                <div class="card-body text-center">

                    <h5>Gold Ring</h5>

                    <p class="gold-text">₹25,000</p>

                    <button class="btn btn-warning">View Details</button>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-4">

            <div class="card product-card">

                <img src="/images/necklace.png" class="card-img-top">

                <div class="card-body text-center">

                    <h5>Gold Necklace</h5>

                    <p class="gold-text">₹75,000</p>

                    <button class="btn btn-warning">View Details</button>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-4">

            <div class="card product-card">

                <img src="/images/bangles.png" class="card-img-top">

                <div class="card-body text-center">

                    <h5>Gold Bangles</h5>

                    <p class="gold-text">₹45,000</p>

                    <button class="btn btn-warning">View Details</button>

                </div>

            </div>

        </div>


        <div class="col-md-3 mb-4">

            <div class="card product-card">

                <img src="/images/silver-chain.png" class="card-img-top">

                <div class="card-body text-center">

                    <h5>Silver Chain</h5>

                    <p class="gold-text">₹5,000</p>

                    <button class="btn btn-warning">View Details</button>

                </div>

            </div>

        </div>

    </div>

</div>


<br>


