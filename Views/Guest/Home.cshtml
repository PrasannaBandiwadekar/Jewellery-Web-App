@{
    ViewData["Title"] = "Home";
}

<style>

    .hero-section {
        background: linear-gradient(rgba(0,0,0,0.6),rgba(0,0,0,0.6)),url('/images/jewellery-banner.jpg');
        background-size: cover;
        background-position: center;
        height: 500px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
    }

        .hero-section h1 {
            font-size: 55px;
            font-weight: bold;
        }

        .hero-section p {
            font-size: 20px;
        }

    .category-card {
        transition: 0.3s;
    }

        .category-card:hover {
            transform: scale(1.05);
        }

    .product-card {
        transition: 0.3s;
    }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

    .gold-text {
        color: #d4af37;
        font-weight: bold;
    }

    .section-title {
        font-weight: 700;
        margin-bottom: 30px;
    }

</style>


<!-- HERO SECTION -->

<section class="hero-section">
    <div>

        <h1>Nagesha Jewellers</h1>

        <p>Luxury Gold & Silver Jewellery Collection</p>

        <a href="/Guest/Designs" class="btn btn-warning btn-lg mt-3">Shop Now</a>

    </div>
</section>


<br>


<!-- CATEGORIES -->

<div class="container">

    <h2 class="text-center section-title">Shop by Category</h2>

    <div class="row">

        <div class="col-md-4 mb-4">

            <div class="card category-card shadow">

                <img src="/images/gold.png" class="card-img-top">

                <div class="card-body text-center">

                    <h4 class="gold-text">Gold Jewellery</h4>

                    <p>Traditional & modern gold designs</p>

                    <a href="/Guest/Designs" class="btn btn-outline-warning">View</a>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-4">

            <div class="card category-card shadow">

                <img src="/images/silver.png" class="card-img-top">

                <div class="card-body text-center">

                    <h4 class="gold-text">Silver Jewellery</h4>

                    <p>Stylish silver ornaments</p>

                    <a href="/Guest/Designs" class="btn btn-outline-warning">View</a>

                </div>

            </div>

        </div>


        <div class="col-md-4 mb-4">

            <div class="card category-card shadow">

                <img src="/images/diamond.png" class="card-img-top">

                <div class="card-body text-center">

                    <h4 class="gold-text">Diamond Jewellery</h4>

                    <p>Luxury diamond collection</p>

                    <a href="/Guest/Designs" class="btn btn-outline-warning">View</a>

                </div>

            </div>

        </div>

    </div>

</div>


<br>


