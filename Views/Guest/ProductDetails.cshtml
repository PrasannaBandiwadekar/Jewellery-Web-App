@model NageshaJewellers.Models.Product

<div class="container mt-5">

    <div class="row">

        <div class="col-md-6">

            <img src="@Model.ImagePath"
                 class="img-fluid rounded shadow">

        </div>

        <div class="col-md-6">

            <h2>@Model.Name</h2>

            <h3 class="text-warning">
                ₹@Model.Price
            </h3>

            <p>@Model.Description</p>

            <h5>Category: @Model.Category</h5>

            <a href="https://wa.me/918421058477"
               class="btn btn-success">
                WhatsApp Enquiry
            </a>

        </div>

    </div>

</div>