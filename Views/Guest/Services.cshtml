@{
    ViewData["Title"] = "Services";
}

<style>

    .services-banner {
        background: linear-gradient(rgba(0,0,0,0.6),rgba(0,0,0,0.6)),url('/images/services-banner.jpg');
        background-size: cover;
        background-position: center;
        height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-align: center;
    }

    .section-title {
        font-weight: 700;
        margin-bottom: 30px;
        color: #d4af37;
    }

    .service-card {
        padding: 25px;
        transition: 0.3s;
    }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        }

    .icon {
        font-size: 40px;
        color: #d4af37;
        margin-bottom: 15px;
    }

</style>


<!-- SERVICES BANNER -->

<section class="services-banner">

    <div>

        <h1 class="display-4 fw-bold">Our Services</h1>

        <p>Quality • Trust • Craftsmanship</p>

    </div>

</section>

<br>


<!-- SERVICES SECTION -->

<div class="container text-center">

    <h2 class="section-title">What We Offer</h2>

    <div class="row">

        <!-- Service 1 -->

        <div class="col-md-4 mb-4">

            <div class="card service-card">

                <div class="icon">💍</div>

                <h4>Custom Jewellery Design</h4>

                <p>

                    We create customized jewellery designs based on your style and preferences.
                    Perfect for weddings, engagements, and special occasions.

                </p>

            </div>

        </div>


        <!-- Service 2 -->

        <div class="col-md-4 mb-4">

            <div class="card service-card">

                <div class="icon">✨</div>

                <h4>Gold & Silver Jewellery</h4>

                <p>

                    Explore our wide range of beautifully crafted gold and silver jewellery
                    for daily wear, festivals, and celebrations.

                </p>

            </div>

        </div>


        <!-- Service 3 -->

        <div class="col-md-4 mb-4">

            <div class="card service-card">

                <div class="icon">💎</div>

                <h4>Diamond Collection</h4>

                <p>

                    Luxury diamond jewellery including rings, necklaces, earrings,
                    and bracelets designed with elegance.

                </p>

            </div>

        </div>


        <!-- Service 4 -->

        <div class="col-md-4 mb-4">

            <div class="card service-card">

                <div class="icon">🔧</div>

                <h4>Jewellery Repair</h4>

                <p>

                    We provide professional jewellery repair services including resizing,
                    polishing, and restoring damaged jewellery.

                </p>

            </div>

        </div>


        <!-- Service 5 -->

        <div class="col-md-4 mb-4">

            <div class="card service-card">

                <div class="icon">🪙</div>

                <h4>Gold Exchange</h4>

                <p>

                    Exchange your old gold jewellery for new designs
                    with transparent and fair value evaluation.

                </p>

            </div>

        </div>


        <!-- Service 6 -->

        <div class="col-md-4 mb-4">

            <div class="card service-card">

                <div class="icon">🏆</div>

                <h4>Hallmarked Jewellery</h4>

                <p>

                    All our jewellery is BIS hallmarked ensuring
                    purity, authenticity, and customer trust.

                </p>

            </div>

        </div>

    </div>

</div>


<br>


<!-- WHY OUR SERVICES -->

<section class="bg-light p-5">

    <div class="container text-center">

        <h2 class="section-title">Why Our Services Are Special</h2>

        <div class="row">

            <div class="col-md-4">

                <h4>✔ Trusted Quality</h4>

                <p>We ensure high quality craftsmanship in every jewellery piece.</p>

            </div>

            <div class="col-md-4">

                <h4>✔ Expert Craftsmen</h4>

                <p>Our jewellery is designed by skilled artisans.</p>

            </div>

            <div class="col-md-4">

                <h4>✔ Customer Satisfaction</h4>

                <p>We prioritize customer happiness and trust.</p>

            </div>

        </div>

    </div>

</section>


<br>


<!-- CALL TO ACTION -->

<section class="bg-warning text-center p-5">

    <h2>Discover Our Exclusive Jewellery Services</h2>

    <p>Visit our designs page to explore beautiful collections.</p>

    <a href="/Guest/Designs" class="btn btn-dark btn-lg">View Designs</a>

</section>