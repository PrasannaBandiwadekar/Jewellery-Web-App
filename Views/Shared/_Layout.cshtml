<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nagesha Jewellers</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --gold-primary: #b8860b;
            --gold-light: #d4af37;
            --dark-luxury: #1a1a1a;
            --soft-white: #fcfcfc;
        }

        body {
            font-family: 'Jost', sans-serif;
            background-color: var(--soft-white);
            color: var(--dark-luxury);
        }

        h1, h2, h3, .navbar-brand {
            font-family: 'Playfair Display', serif;
        }

        /* --- NAVBAR IMPROVEMENTS --- */
        .navbar {
            padding: 15px 0;
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px); /* Modern glass effect */
            border-bottom: 1px solid rgba(184, 134, 11, 0.2);
        }

        .navbar-brand {
            font-size: 26px;
            letter-spacing: 1px;
            color: var(--gold-primary) !important;
        }

        .nav-link {
            text-transform: uppercase;
            font-size: 13px;
            letter-spacing: 2px;
            margin: 0 10px;
            color: var(--dark-luxury) !important;
            position: relative;
        }

            .nav-link::after {
                content: '';
                position: absolute;
                width: 0;
                height: 1px;
                bottom: 0;
                left: 50%;
                background-color: var(--gold-primary);
                transition: all 0.3s ease;
            }

            .nav-link:hover::after {
                width: 80%;
                left: 10%;
            }

        /* --- AUTH BUTTONS --- */
        .btn-auth {
            border-radius: 0; /* Sharp corners look more premium */
            padding: 8px 24px;
            font-size: 13px;
            letter-spacing: 1px;
            text-transform: uppercase;
            transition: 0.4s;
        }

        .btn-login {
            border: 1px solid var(--dark-luxury);
            color: var(--dark-luxury);
        }

            .btn-login:hover {
                background: var(--dark-luxury);
                color: white;
            }

        .btn-gold {
            background-color: var(--gold-primary);
            color: white;
            border: 1px solid var(--gold-primary);
        }

            .btn-gold:hover {
                background-color: transparent;
                color: var(--gold-primary);
            }

        /* --- FOOTER --- */
        footer {
            background: var(--dark-luxury);
            color: #999;
            padding: 60px 0 30px;
            font-size: 14px;
        }

        .footer-title {
            color: var(--gold-light);
            font-family: 'Playfair Display', serif;
            margin-bottom: 20px;
        }

        .footer-link {
            color: #999;
            text-decoration: none;
            display: block;
            margin-bottom: 10px;
            transition: 0.3s;
        }

            .footer-link:hover {
                color: var(--gold-light);
                padding-left: 5px;
            }

        .social-icons a {
            font-size: 20px;
            color: var(--gold-light);
            margin-right: 15px;
            text-decoration: none;
        }

        .border-gold {
            border-top: 1px solid rgba(212, 175, 55, 0.3);
            margin-top: 40px;
            padding-top: 20px;
        }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Guest" asp-action="Home">
                    NAGESHA <span style="font-weight:300">JEWELLERS</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMenu">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Guest" asp-action="Home">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Guest" asp-action="AboutUs">Our Story</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Guest" asp-action="Services">Services</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Guest" asp-action="Designs">Collections</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Guest" asp-action="Contact">Contact</a></li>
                    </ul>

                    <form asp-controller="Guest"
                          asp-action="Search"
                          method="get"
                          class="d-flex ms-3">

                        <input type="text"
                               name="searchText"
                               class="form-control me-2"
                               placeholder="Search Jewellery">

                        <button type="submit"
                                class="btn btn-warning">

                            Search

                        </button>

                    </form>

                    <div class="d-flex align-items-center">
                        @if (Context.Session.GetString("UserEmail") != null)
                        {
                            <div class="dropdown">
                                <a class="nav-link dropdown-toggle text-success" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> @Context.Session.GetString("UserName")
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout">Logout</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-auth btn-login me-2" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-auth btn-gold" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <h4 class="footer-title">Nagesha Jewellers</h4>
                    <p>Crafting timeless elegance since decades. Our commitment to purity and traditional craftsmanship makes us your trusted partner for every celebration.</p>
                    <div class="social-icons">
                        <a href="#"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fab fa-instagram"></i></a>
                        <a href="#"><i class="fab fa-whatsapp"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 mb-4">
                    <h6 class="text-white text-uppercase fw-bold">Quick Links</h6>
                    <a class="footer-link" asp-controller="Guest" asp-action="Home">Home</a>
                    <a class="footer-link" asp-controller="Guest" asp-action="Designs">Collections</a>
                    <a class="footer-link" asp-controller="Guest" asp-action="Services">Services</a>
                </div>
                <div class="col-lg-3 col-md-4 mb-4">
                    <h6 class="text-white text-uppercase fw-bold">Contact Info</h6>
                    <p class="mb-1"><i class="fas fa-map-marker-alt me-2"></i> Shirol, Kolhapur, Maharashtra</p>
                    <p class="mb-1"><i class="fas fa-phone me-2"></i> +91 8421058477</p>
                    <p><i class="fas fa-envelope me-2"></i> bandiwadekarprasanna@gmail.com</p>
                </div>
            </div>

            <div class="text-center border-gold">
                <p class="mb-0">&copy; 2026 Nagesha Jewellers. All Rights Reserved. | <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none" style="color:#666">Privacy</a></p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/your-code-here.js" crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>