<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nagesha Jewellers</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }

        .navbar {
            padding: 12px 0;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 22px;
            color: #b8860b !important;
        }

        .nav-link {
            font-weight: 500;
            margin-right: 15px;
            transition: 0.3s;
        }

        .nav-link:hover {
            color: #b8860b !important;
        }

        .btn-gold {
            background-color: #b8860b;
            color: white;
            border-radius: 20px;
            padding: 6px 15px;
        }

        .btn-gold:hover {
            background-color: #a37509;
            color: white;
        }

        footer {
            background: #111;
            color: #ddd;
            padding: 30px 0;
        }

        footer a {
            color: #b8860b;
            text-decoration: none;
        }

        footer a:hover {
            text-decoration: underline;
        }

        .social-icons a {
            margin-right: 10px;
            font-size: 18px;
            color: #ddd;
        }

        .social-icons a:hover {
            color: #b8860b;
        }
    </style>

</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
            <div class="container">

                <a class="navbar-brand" asp-controller="Guest" asp-action="Home">
                    💎 Nagesha Jewellers
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMenu">

                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Guest" asp-action="Home">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Guest" asp-action="AboutUs">About Us</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Guest" asp-action="Services">Services</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Guest" asp-action="Designs">Designs</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Guest" asp-action="Contact">Contact</a>
                        </li>

                    </ul>

                    <!-- Right Side Buttons -->
                    <div class="d-flex">

                        @{
                            var user = Context.Session.GetString("UserEmail");
                        }

                        @if (user != null)
                        {
                            <span class="me-3 mt-2 text-success">Welcome @user</span>

                            <a class="btn btn-danger" asp-controller="Account" asp-action="Logout">Logout</a>
                        }
                        else
                        {
                            <a class="btn btn-outline-dark me-2" asp-controller="Account" asp-action="Login">Login</a>

                            <a class="btn btn-warning" asp-controller="Account" asp-action="Register">Register</a>
                        }

                    </div>

                </div>
            </div>
        </nav>
    </header>


    <!-- PAGE CONTENT -->
    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>


    <!-- FOOTER -->
    <footer class="mt-5">
        <div class="container text-center">

            <h5>Nagesha Jewellers</h5>
            <p>Premium Gold & Diamond Jewellery</p>

            <div class="social-icons mb-3">
                <a href="#">Facebook</a>
                <a href="#">Instagram</a>
                <a href="#">WhatsApp</a>
            </div>

            <p class="mb-0">
                © 2026 Nagesha Jewellers |
                <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
            </p>

        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>